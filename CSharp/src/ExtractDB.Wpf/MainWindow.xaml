<Window x:Class="ExtractDB.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExtractDB"
        MinHeight="640"
        MinWidth="980"
        Height="720"
        Width="1120">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <DockPanel Background="#F6F7F9">
        <Border DockPanel.Dock="Bottom"
                Background="#FFFFFF"
                BorderBrush="#D8DDE6"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProgressMessage}" Foreground="#566274" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Cancelar"
                        Command="{Binding CancelCommand}" />
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF"
                    BorderBrush="#D8DDE6"
                    BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="ExtractDB" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
                    <Button Content="1. Conexão" Command="{Binding GoToConnectionCommand}" Margin="0,0,0,8" />
                    <Button Content="2. Seleção" Command="{Binding GoToSelectionCommand}" Margin="0,0,0,8" />
                    <Button Content="3. Geração" Command="{Binding GoToConfigurationCommand}" Margin="0,0,0,8" />
                    <TextBlock Text="Fluxo: conectar, ler metadata, selecionar objetos, gerar arquivos e revisar resultado."
                               TextWrapping="Wrap"
                               Foreground="#566274"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    BorderBrush="#D8DDE6"
                    BorderThickness="1"
                    Padding="22">
                <Grid>
                    <Grid Visibility="{Binding IsConnectionStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Conexão" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <Grid Grid.Row="1" MaxWidth="520" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Provider" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding Connection.ProviderOptions}"
                                      SelectedItem="{Binding Connection.Provider}" />

                            <TextBlock Grid.Row="1" Text="Servidor" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Connection.Server, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Text="Porta" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Connection.Port, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="3" Text="Database" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Connection.Database, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Text="Usuário" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Connection.UserName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="5" Text="Senha" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Connection.Password, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Testar conexão" Command="{Binding TestConnectionCommand}" />
                            <Button Content="Ler metadata" Command="{Binding ReadMetadataCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsMetadataReadingStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Lendo metadata" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Width="360" Height="18" Margin="0,18,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsObjectSelectionStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Seleção de objetos" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ObjectSelection.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,12" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ObjectSelection.ObjectTypeFilters}"
                                      SelectedItem="{Binding ObjectSelection.ObjectTypeFilter}"
                                      Margin="0,0,12,12" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Todos" Command="{Binding SelectAllCommand}" />
                                <Button Content="Nenhum" Command="{Binding UnselectAllCommand}" />
                                <Button Content="Inverter" Command="{Binding InvertSelectionCommand}" />
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding ObjectSelection.VisibleItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Gerar" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding ObjectType}" IsReadOnly="True" Width="140" />
                                <DataGridTextColumn Header="Objeto" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Configurar geração" Command="{Binding GoToConfigurationCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsGenerationConfigurationStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Configuração de geração" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <Grid Grid.Row="1" MaxWidth="680" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Namespace base" />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding GenerationConfiguration.NamespaceBase, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Text="Pasta de saída" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding GenerationConfiguration.OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="1" Grid.Column="2"
                                    Content="Escolher"
                                    Command="{Binding BrowseOutputDirectoryCommand}" />
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Voltar" Command="{Binding GoToSelectionCommand}" />
                            <Button Content="Gerar" Command="{Binding GenerateCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsGenerationStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Gerando arquivos" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Width="360" Height="18" Margin="0,18,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsResultStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Resultado" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />

                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                            <GroupBox Header="Success">
                                <TextBlock Text="{Binding Result.SuccessCount}" FontSize="28" FontWeight="SemiBold" />
                            </GroupBox>
                            <GroupBox Header="Warnings">
                                <TextBlock Text="{Binding Result.WarningCount}" FontSize="28" FontWeight="SemiBold" />
                            </GroupBox>
                            <GroupBox Header="Errors">
                                <TextBlock Text="{Binding Result.ErrorCount}" FontSize="28" FontWeight="SemiBold" />
                            </GroupBox>
                        </UniformGrid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Result.Messages}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100" />
                                <DataGridTextColumn Header="Type" Binding="{Binding ObjectType}" Width="110" />
                                <DataGridTextColumn Header="Schema" Binding="{Binding Schema}" Width="120" />
                                <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="160" />
                                <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="140" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
